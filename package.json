{
  "name": "@zxs4khf/aeos",
  "version": "2.0.0-alpha.5",
  "private": false,
  "description": "Agent-agnostic engineering policy compiler and workflow toolkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxs4KHf/aeos.git"
  },
  "homepage": "https://github.com/zxs4KHf/aeos#readme",
  "bugs": {
    "url": "https://github.com/zxs4KHf/aeos/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "codex",
    "engineering-policy",
    "github-action"
  ],
  "type": "commonjs",
  "bin": {
    "aeos": "bin/aeos.js"
  },
  "files": [
    "bin/",
    "adapters/",
    "policies/",
    "schemas/",
    "constitution/",
    "standards/",
    "workflows/",
    "playbooks/",
    "templates/",
    "dist/",
    "eval/",
    "action.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node adapters/compiler.js --platform all",
    "check": "node adapters/compiler.js --platform all --check",
    "test": "node --test test/*.test.js",
    "test:fixtures": "node eval/verify-fixtures.js",
    "eval": "node eval/context-cost.js",
    "eval:adherence": "node eval/adherence.js",
    "verify": "npm run test && npm run test:fixtures && npm run check",
    "prepack": "npm run verify"
  }
}

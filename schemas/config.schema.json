{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeos.dev/schemas/config.schema.json",
  "title": "AEOS Adapter Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policySource", "knowledge", "maxEntryLines", "pipelines"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "policySource": { "type": "string", "minLength": 1 },
    "knowledge": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "maxEntryLines": { "type": "integer", "minimum": 20 },
    "maxEntryTokens": {
      "type": "integer",
      "minimum": 100,
      "description": "Optional budget for the rough token estimate (characters / 4) of each rendered entry."
    },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "renderer", "target", "installTarget"],
        "properties": {
          "platform": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "renderer": { "enum": ["agents", "cursor", "markdown", "system"] },
          "canonical": {
            "type": "boolean",
            "description": "Marks the single canonical AGENTS.md pipeline that pointer entries reference."
          },
          "readsAgentsMd": {
            "type": "boolean",
            "description": "Client reads the canonical AGENTS.md natively; installs render a short pointer entry instead of a duplicate body when the canonical entry is present."
          },
          "scopedRules": {
            "type": "boolean",
            "description": "Render policies with appliesTo globs as platform scoped rules (Cursor auto-attached .mdc, Copilot applyTo instructions)."
          },
          "commands": {
            "type": "boolean",
            "description": "Compile workflows/ into platform command prompts at install time."
          },
          "commandsTarget": {
            "type": "string",
            "minLength": 1,
            "description": "Directory for compiled command prompts (default .claude/commands)."
          },
          "target": { "type": "string", "pattern": "^dist/" },
          "installTarget": { "type": "string", "minLength": 1 },
          "mirrors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
